@echo off
chcp 65001 >nul
title رفع مسار المعلم إلى GitHub
echo ================================================================
echo        مسار المعلم PRO - رفع وتحديث المشروع إلى GitHub
echo ================================================================
echo.
echo [1/3] جاري فحص وترتيب كافة المجلدات الـ 5 والملفات...
cd /d "%~dp0\.."

git add .
git diff-index --quiet HEAD --
if %ERRORLEVEL% neq 0 (
    git commit -m "update: sync all 5 project modules and files for production deployment"
) else (
    echo [✓] كافة الملفات محفوظة ومحدثة مسبقاً في Git.
)

echo.
echo [2/3] جاري رفع كافة المجلدات إلى المستودع الرسمي:
echo       https://github.com/qqhhhhaa-jpg/10.10.3000
echo.
echo [ملاحظة هامة]: إذا ظهرت نافذة تسجيل الدخول من متصفحك:
echo               اضغط على زر (Sign in with your browser)
echo.
git push -u origin main

if %ERRORLEVEL% equ 0 (
    echo.
    echo ================================================================
    echo  [✓✓✓] تم رفع المشروع كاملاً بجميع المجلدات الـ 5 بنجاح تام!
    echo  ستظهر الآن كافة التنسيقات والألوان والأيقونات والبرمجيات
    echo  في موقعك المنشور على الإنترنت فوراً وبدون أي نقص.
    echo ================================================================
) else (
    echo.
    echo ================================================================
    echo  [!] تعذر إكمال الرفع تلقائياً.
    echo  السبب الأكثر شيوعاً: يحتاج GitHub إلى تسجيل الدخول في المتصفح.
    echo  يرجى المحاولة مجدداً أو مراجعة دليل_نشر_الموقع_على_الانترنت.md
    echo ================================================================
)

echo.
pause
