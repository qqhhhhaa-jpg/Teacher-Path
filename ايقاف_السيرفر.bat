@echo off
chcp 65001 > nul
title 🛑 إيقاف بوت السيرفر - مُعَلِّم برو
color 0C

echo ===============================================================================
echo                🛑 جاري إيقاف بوت السيرفر وإنهاء كافة العمليات...
echo ===============================================================================
echo.

:: إنهاء عملية السيرفر على المنفذ 8080 و 3000
for /f "tokens=5" %%a in ('netstat -aon ^| findstr ":8080" ^| findstr "LISTENING"') do (
    echo تم العثور على السيرفر على المنفذ 8080 برقم العملية (PID: %%a)، جاري الإيقاف...
    taskkill /F /PID %%a > nul 2>&1
)

:: إنهاء عملية نفق Cloudflare إن وجدت
taskkill /F /IM cloudflared.exe > nul 2>&1

echo.
echo ✅ تم إيقاف السيرفر وبوت الحراسة بنجاح!
echo اضغط أي زر للإغلاق...
pause > nul
