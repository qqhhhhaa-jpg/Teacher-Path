@echo off
chcp 65001 >nul
title رفع مسار المعلم إلى GitHub
echo ================================================================
echo        مسار المعلم PRO - رفع وتحديث المشروع إلى GitHub
echo ================================================================
echo.
echo [1/3] جاري فحص الملفات المحدثة وترتيبها...
cd /d "%~dp0"
git add .

echo [2/3] جاري حفظ التعديلات...
git diff-index --quiet HEAD --
if %ERRORLEVEL% neq 0 (
    git commit -m "update: sync platform files for deployment"
) else (
    echo [✓] كافة الملفات محفوظة ومحدثة مسبقاً.
)

echo.
echo [3/3] جاري الرفع إلى المستودع الرسمي على GitHub (origin/main)...
echo إذا ظهرت لك نافذة تسجيل الدخول من GitHub، اضغط Sign in with your browser.
echo.
git push origin main
echo.

if %ERRORLEVEL% equ 0 (
    echo ================================================================
    echo  [✓] تم رفع كافة الملفات والتصاميم إلى GitHub بنجاح تام!
    echo  إذا كان مشروعك مربوطاً مع Vercel أو Render أو Netlify،
    echo  فسيبدأ النشر التلقائي للموقع الحي مباشرة الآن.
    echo ================================================================
) else (
    echo ================================================================
    echo  [!] تعذر إكمال الرفع. تحقق من اتصال الإنترنت وصلاحيات GitHub.
    echo ================================================================
)
echo.
pause
