@echo off
chcp 65001 >nul
title رفع مسار المعلم إلى GitHub
echo ================================================================
echo        مسار المعلم PRO - رفع التحديثات والملفات إلى GitHub
echo ================================================================
echo.
echo جاري رفع التصاميم والمجلدات (css, js, assets, app.py, requirements.txt)...
echo إذا ظهرت لك نافذة تسجيل الدخول من GitHub، اضغط Sign in with your browser.
echo.
cd /d "%~dp0"
git push origin main
echo.
if %ERRORLEVEL% equ 0 (
    echo ================================================================
    echo  [✓] تم رفع كافة الملفات والتصاميم إلى GitHub بنجاح!
    echo  سيبدأ Render الآن في إعادة البناء التلقائي ويظهر الموقع بكامل جماله.
    echo ================================================================
) else (
    echo ================================================================
    echo  [!] حدث خطأ أثناء الرفع. تأكد من اتصال الإنترنت وتسجيل الدخول في GitHub.
    echo ================================================================
)
echo.
pause
